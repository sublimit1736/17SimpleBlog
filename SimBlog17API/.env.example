# Environment variables for the application

# Server configuration
SERVER_PORT=8080

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=simpleblog
POSTGRES_IMAGE=postgres:latest

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_IMAGE=redis:latest

# Application security configuration
APP_ADMIN_USERNAME=change_me
APP_ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_with_32_plus_chars_minimum
JWT_ISSUER=simblog17api
JWT_CLOCK_SKEW_SECONDS=30

# Encryptor configuration (required for production; use strong random values)
APP_CRYPTO_AES_SECRET=change_me_with_32_plus_chars
APP_CRYPTO_XOR_PEPPER=change_me_with_another_random_string

# Active profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# ── MetaConfig 站长口令 ────────────────────────────────────
# 明文口令，首次启动后将以 BCrypt 哈希形式保存到数据库，原始值不再使用。
# 若要重置口令：修改此值，删除数据库 site_settings 表中 owner.token.hash 行，重启服务。
OWNER_TOKEN=change_me_to_a_strong_owner_token
# 每个窗口期（默认60秒）内同一 IP 最多允许校验失败次数
OWNER_TOKEN_MAX_ATTEMPTS=5
