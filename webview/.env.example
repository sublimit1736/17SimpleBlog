# ============================================================
# webview 前端环境变量示例
# 复制此文件为 .env（开发）或 .env.production（生产），按需修改
# Vite 只将 VITE_ 前缀的变量注入客户端代码
# ============================================================

# ── 后端地址 ─────────────────────────────────────────────────
# 向后端发送请求的主机地址（不含协议和端口）
VITE_BACKEND_ADDRESS=localhost

# 向后端发送请求的端口
VITE_BACKEND_PORT=8080

# 如需完整自定义 API Base URL，可直接设置（设置后上面两个变量将被忽略）
# VITE_API_BASE_URL=http://your-domain.com/api

# ── 网站名称 ─────────────────────────────────────────────────
# 替换页面标题中的 "Chunana的个人博客" 字样（浏览器标签、Logo、Hero 标题等）
VITE_SITE_NAME=Chunana的个人博客

# ── 站点基础配置页面 ─────────────────────────────────────────
# 是否启用 /metaconfig 页面（true=启用，false=访问时跳转权限不足页面）
VITE_META_CONFIG_ENABLE=true
